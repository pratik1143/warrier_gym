# ==================================================
# THE WARRIOR GYM - BIOMETRIC AGENT CONFIGURATION
# ==================================================

# Active Biometric Provider: 'hikvision', 'essl', or 'both'
ACTIVE_BIOMETRIC_PROVIDER=hikvision

# --------------------------------------------------
# HIKVISION DS-K1T320EFWX CONFIGURATION
# --------------------------------------------------
# Note: Read from environment, never hardcode IP
HIKVISION_HOST=192.168.1.45
HIKVISION_PORT=443
HIKVISION_PROTOCOL=https
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=Password0@@
HIKVISION_DEVICE_ID=hikvision-main-gate
HIKVISION_DEVICE_NAME=The Warrior Gym - Main Entrance
HIKVISION_DOOR_ID=1
HIKVISION_BRANCH=The Warrior Gym Main Branch

# --------------------------------------------------
# ESSL K90 PRO CONFIGURATION (Preserved for full compatibility)
# --------------------------------------------------
ESSL_HOST=192.168.18.11
ESSL_PORT=4370
ESSL_DEVICE_ID=dev_k90_main
ESSL_DEVICE_NAME=ESSL K90 Pro

# --------------------------------------------------
# AGENT RUNTIME & BACKEND
# --------------------------------------------------
POLL_INTERVAL_SECONDS=3
CONNECTION_TIMEOUT_SECONDS=5
RECONNECT_BACKOFF_SECONDS=5
WARRIOR_BACKEND_URL=http://localhost:5000/api
FIREBASE_CREDENTIALS_PATH=../backend/serviceAccountKey.json
