# The Warrior Gym — Environment Variables Template

# Frontend Firebase Configuration (Supports Vite & Next.js)
VITE_FIREBASE_API_KEY=your_warrior_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=warrior-gym-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=warrior-gym-prod
VITE_FIREBASE_STORAGE_BUCKET=warrior-gym-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

NEXT_PUBLIC_FIREBASE_API_KEY=your_warrior_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=warrior-gym-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=warrior-gym-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=warrior-gym-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Backend Firebase Service Account (Server Side Only)
FIREBASE_PROJECT_ID=warrior-gym-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@warrior-gym-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# API & Server Settings
PORT=5000
NODE_ENV=development
